# Professional Tkinter App: "Focus Timer" (Pomodoro Technique)

This app is a sleek, professional Pomodoro-style focus timer. It helps users work in focused intervals with short breaks, using a modern layout and color scheme. The GUI uses frames for structure, custom fonts for clarity, and a harmonious palette suitable for professional environments.

---

### Features

- Start/stop/reset timer controls
- Visual countdown display
- Session/break indicator
- Modern colors and fonts

---

### Python Code

```python
import tkinter as tk
from tkinter import font

# --- Constants ---
WORK_MIN = 25  # Work session duration in minutes
BREAK_MIN = 5  # Break duration in minutes

PRIMARY_COLOR = "#2E4053"
ACCENT_COLOR = "#58D68D"
BG_COLOR = "#F4F6F7"
FONT_FAMILY = "Segoe UI"

class FocusTimerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Focus Timer")
        self.root.geometry("350x250")
        self.root.configure(bg=BG_COLOR)
        self.is_running = False
        self.is_work_session = True
        self.remaining_seconds = WORK_MIN * 60
        
        # Fonts 
        self.title_font = font.Font(family=FONT_FAMILY, size=18, weight="bold")
        self.timer_font = font.Font(family=FONT_FAMILY, size=36)
        
        # Frames 
        top_frame = tk.Frame(root, bg=BG_COLOR)
        top_frame.pack(pady=(20,10))
        
        mid_frame = tk.Frame(root, bg=BG_COLOR)
        mid_frame.pack(pady=(0,10))
        
        bottom_frame = tk.Frame(root, bg=BG_COLOR)
        bottom_frame.pack()
        
        # Widgets 
        # Title Label 
        title_lbl = tk.Label(top_frame, text="Focus Timer", bg=BG_COLOR,
                         fg=PRIMARY_COLOR, font=self.title_font)
        title_lbl.pack()
         
        # Session Indicator 
        self.session_lbl = tk.Label(mid_frame, text="Work Session",
                                bg=BG_COLOR,
                                fg="#117A65",
                                font=(FONT_FAMILY, "12", "bold"))
        self.session_lbl.pack()
         
        # Timer Display 
        self.timer_lbl = tk.Label(mid_frame, text=self.format_time(self.remaining_seconds),
                              bg=ACCENT_COLOR,
                              fg="white",
                              width=8,
                              pady=10,
                              font=self.timer_font)
        self.timer_lbl.pack(pady=(8,0))
         
        # Controls 
        start_btn = tk.Button(bottom_frame, text="Start", command=self.start_timer, bg="#2874A6",
                           fg="white", font=(FONT_FAMILY, "11", "bold"), width=7, borderwidth=0,
                           activebackground="#1B4F72")
        start_btn.grid(row=0, column=0, padx=(0,8))
          
        stop_btn = tk.Button(bottom_frame, text="Stop", command=self.stop_timer, bg="#B9770E",
                          fg="white", font=(FONT_FAMILY, "11", "bold"), width=7, borderwidth=0,
                          activebackground="#873600")
        stop_btn.grid(row=0, column=1, padx=(8,8))
          
        reset_btn = tk.Button(bottom_frame, text="Reset", command=lambda: self.reset_timer(), 
                           bg="#839192", fg="white", font=(FONT_FAMILY, "11", "bold"),
                           width=7, borderwidth=0, activebackground="#566573")
        reset_btn.grid(row=0, column=2, padx=(8,0))
           
    def format_time(self, secs):
       mins = int(secs//60)
       sec = int(secs%60)
       return f"{mins:02d}:{sec:02d}"
   
    def update_display(self):
      if(self.is_work_session):
           text_color = "#117A65"
           label_text = "Work Session"
      else:
           text_color = "#AF601A"
           label_text = "Break Time!"
      self.session_lbl.config(text=label_text, fg=text_color)
      if(not(self.is_running)):
            pass  
      else:
            pass  
      time_str = self.format_time(int(max([self.remaining_seconds, 0])))
      if(not(self.is_running)):
            pass
