# App Idea: "Mood Palette" – A Real-Time Mood-to-Color Visualizer

**Concept:**  
"Mood Palette" is a unique, interactive Tkinter app that lets users express their current mood with a single click and instantly see it translated into a professional color palette. The app uses modern design principles—elegant frames, smooth fonts, and harmonious colors—to create an engaging experience. Unlike typical mood trackers or color pickers, this app bridges emotion and design inspiration in real time.

---

## Features

- **Mood Buttons:** Users select from several moods (e.g., Happy, Calm, Energetic, Focused).
- **Dynamic Color Palettes:** Each mood generates a curated palette of 5 professional colors.
- **Palette Preview:** Colors are displayed as swatches with hex codes for easy copying.
- **Copy to Clipboard:** Click any swatch to copy its hex code.
- **Modern UI:** Uses stylish frames (rounded corners), soft gradients/backgrounds, and clean sans-serif fonts.

---

## Python Code (`mood_palette.py`)

```python
import tkinter as tk
from tkinter import font
from tkinter import messagebox

# Professional palettes mapped to moods
MOOD_PALETTES = {
    "Happy": ["#FFD166", "#FFB703", "#FB8500", "#90BE6D", "#43AA8B"],
    "Calm": ["#A9DEF9", "#E4C1F9", "#CBAACB", "#F7D6E0", "#B8F2E6"],
    "Energetic": ["#EF476F", "#FFD166", "#06D6A0", "#118AB2", "#073B4C"],
    "Focused": ["#22223B", "#4A4E69", "#9A8C98", "#C9ADA7","#F2E9E4"]
}

class MoodPaletteApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Mood Palette")
        self.configure(bg="#232946")
        self.geometry("420x380")
        self.resizable(False, False)
        
        # Fonts
        self.header_font = font.Font(family="Segoe UI Semibold",
                                     size=22,
                                     weight="bold")
        self.button_font = font.Font(family="Segoe UI",
                                     size=12)
        
        # Header Frame
        header_frame = tk.Frame(self,
                                bg="#232946",
                                pady=14)
        header_frame.pack(fill='x')
        
        header_label = tk.Label(header_frame,
                                text="How do you feel today?",
                                fg="#fffffe",
                                bg="#232946",
                                font=self.header_font)
        header_label.pack()
        
        # Mood Button Frame
        button_frame = tk.Frame(self,
                                bg="#232946")
        button_frame.pack(pady=(10, 18))
        
        for idx,mood in enumerate(MOOD_PALETTES.keys()):
            btn=tk.Button(button_frame,
                          text=mood,
                          width=10,
                          height=1,
                          relief='flat',
                          borderwidth=0,
                          fg='#232946',
                          bg='#eebbc3',
                          activebackground='#b8c1ec',
                          activeforeground='#121629',
                          font=self.button_font,
                          command=lambda m=mood:self.show_palette(m))
            btn.grid(row=0,column=idx,padx=(5 if idx else 0 ,5),pady=(3))
            
            btn.bind("<Enter>", lambda e,b=btn: b.config(bg='#b8c1ec'))
            btn.bind("<Leave>", lambda e,b=btn: b.config(bg='#eebbc3'))
            
        
    
       # Palette Display Frame 
       self.palette_frame=tk.Frame(self,bg="#393d53") 
       self.palette_frame.pack(pady=(10,20),fill='both',expand=True) 
        
       # Info Label 
       info_lbl=tk.Label(self,text="Select your mood above\nto generate your color palette.",fg="#b8c1ec",
                         bg="#232946",
                         justify='center',font=("Segoe UI Italic","11"))
       info_lbl.pack()
       
       
   def show_palette(self,mood): 
      for widget in self.palette_frame.winfo_children(): 
          widget.destroy() 
        
      colors = MOOD_PALETTES[mood] 
        
      swatch_size_w ,swatch_size_h =(60 ,60) 
        
      for i,color in enumerate(colors): 
         frame=tk.Frame(self.palette_frame,width=swatch_size_w,height=swatch_size_h,bg=color,cursor="hand2"
                       ,highlightthickness=2 if i==2 else 0 ,
                       highlightbackground ="#fffffe" if i==2 else color )
         frame.grid(row=i,column=0,padx=(15),pady=(7)) 
         frame.grid_propagate(False) 

         label=tk.Label(frame,text=color.upper(),bg=color ,
                        fg ="black" if int(color[1:3],16)>180 else 'white' ,
                        font=("Segoe UI Semibold","11"))
         label.place(relx=.5,rely=.65 ,anchor='center')
         
         frame.bind("<Button-1>",lambda e,c=color:self.copy_color(c))  
         label.bind("<Button-1>",lambda e,c=color:self.copy_color(c))  

   def copy_color(self,color):  
     try:
          self.clipboard_clear()  
          self.clipboard_append(color.upper())  
          messagebox.showinfo("Copied!",f"{color.upper()} copied to clipboard.")   
     except Exception as ex:
           messagebox.showerror("Error","Could not copy the color code.")
           
if __name__=="__main__":
   app=MoodPaletteApp()
   app.mainloop()
```

