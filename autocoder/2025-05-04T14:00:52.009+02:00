# Weather Dashboard App

I'm excited to share a special Python app with a Tkinter GUI that I've created for you! This Weather Dashboard app allows users to check current weather conditions for any city. Let's dive into the code and design.

## The Weather Dashboard App

```python
import tkinter as tk
from tkinter import ttk, messagebox
import requests
import json
from datetime import datetime
from PIL import Image, ImageTk
import io
import urllib.request

class WeatherDashboard:
    def __init__(self, root):
        self.root = root
        self.root.title("Weather Dashboard")
        self.root.geometry("800x600")
        self.root.resizable(False, False)
        
        # Set color scheme
        self.primary_color = "#3498db"  # Blue
        self.secondary_color = "#2c3e50"  # Dark Blue
        self.accent_color = "#e74c3c"  # Red
        self.bg_color = "#ecf0f1"  # Light Gray
        self.text_color = "#2c3e50"  # Dark Blue
        
        self.root.configure(bg=self.bg_color)
        
        # Create custom fonts
        self.title_font = ("Helvetica", 24, "bold")
        self.header_font = ("Helvetica", 16, "bold")
        self.normal_font = ("Helvetica", 12)
        self.small_font = ("Helvetica", 10)
        
        self.create_widgets()
    
    def create_widgets(self):
        # Create header frame
        header_frame = tk.Frame(self.root, bg=self.secondary_color, height=80)
        header_frame.pack(fill=tk.X)
        
        # App title
        title_label = tk.Label(
            header_frame, 
            text="Weather Dashboard", 
            font=self.title_font, 
            bg=self.secondary_color, 
            fg="white"
        )
        title_label.pack(pady=20)
        
        # Create search frame
        search_frame = tk.Frame(self.root, bg=self.bg_color, pady=20)
        search_frame.pack(fill=tk.X)
        
        # City entry and search button
        self.city_entry = ttk.Entry(
            search_frame, 
            font=self.normal_font, 
            width=30
        )
        self.city_entry.insert(0, "Enter city name...")
        self.city_entry.bind("<FocusIn>", lambda e: self.city_entry.delete(0, tk.END) if self.city_entry.get() == "Enter city name..." else None)
        self.city_entry.pack(side=tk.LEFT, padx=(100, 10))
        
        # Style for the button
        style = ttk.Style()
        style.configure("Search.TButton", font=self.normal_font)
        
        search_button = ttk.Button(
            search_frame, 
            text="Search", 
            style="Search.TButton",
            command=self.get_weather
        )
        search_button.pack(side=tk.LEFT)
        
        # Create content frame
        self.content_frame = tk.Frame(self.root, bg=self.bg_color)
        self.content_frame.pack(fill=tk.BOTH, expand=True, padx=50, pady=20)
        
        # Weather info frame (initially empty)
        self.weather_frame = tk.Frame(self.content_frame, bg=self.bg_color)
        self.weather_frame.pack(fill=tk.BOTH, expand=True)
        
        # Initial message
        self.initial_msg = tk.Label(
            self.weather_frame,
            text="Enter a city name to get weather information",
            font=self.header_font,
            bg=self.bg_color,
            fg=self.text_color
        )
        self.initial_msg.pack(pady=100)
        
        # Create footer
        footer_frame = tk.Frame(self.root, bg=self.secondary_color, height=40)
        footer_frame.pack(fill=tk.X, side=tk.BOTTOM)
        
        footer_text = tk.Label(
            footer_frame,
            text="© 2025 Weather Dashboard | Data from OpenWeatherMap",
            font=self.small_font,
            bg=self.secondary_color,
            fg="white"
        )
        footer_text.pack(pady=10)
    
    def get_weather(self):
        city = self.city_entry.get()
        
        if city == "" or city == "Enter city name...":
            messagebox.showerror("Error", "Please enter a city name")
            return
        
        # API key (get your own from openweathermap.org)
        api_key = "YOUR_API_KEY"
        url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={api_key}&units=metric"
        
        try:
            # For demo purposes, we'll use mock data instead of making an actual API call
            # In a real app, you would use: response = requests.get(url)
            # And then: weather_data = json.loads(response.text)
            
            # Mock data for demonstration
