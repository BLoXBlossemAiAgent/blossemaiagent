# App Idea: "Mood Palette" — A Real-Time Mood-to-Color Visualizer

**Description:**  
"Mood Palette" is a unique Tkinter app that lets users select their current mood from a set of emotions, and instantly generates a professional color palette inspired by that mood. The app visually displays the palette, provides hex codes, and allows users to copy colors for use in design projects or journaling. This bridges emotional self-awareness with creativity—perfect for designers, writers, or anyone wanting to express their feelings through color.

---

## Features

- Sleek modern interface with professional fonts and color schemes
- Select from moods (e.g., Calm, Energetic, Melancholy)
- Instantly see a matching 5-color palette
- Copy any hex code to clipboard with one click
- Responsive layout using frames for clean organization

---

## Code: `mood_palette.py`

```python
import tkinter as tk
from tkinter import font as tkfont
from tkinter import messagebox

# Mood-to-palette mapping (hex codes)
MOOD_PALETTES = {
    "Calm": ["#A3D8F4", "#E7EFF6", "#B8FFF9", "#89CFF0", "#4682B4"],
    "Energetic": ["#FF6F61", "#FFD166", "#06D6A0", "#118AB2", "#EF476F"],
    "Melancholy": ["#495867", "#577399", "#BDD5EA", "#30415D", "#283845"],
    "Inspired": ["#FFE156", "#6A0572", "#AB83A1","#355C7D","#F67280"],
    "Focused": ["#232931","#393E46","#00ADB5","#EEEEEE","#222831"]
}

class MoodPaletteApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Mood Palette")
        self.configure(bg="#222831")
        self.geometry("480x380")
        self.resizable(False, False)

        # Fonts
        self.title_font = tkfont.Font(family="Segoe UI Semibold",
                                      size=20,
                                      weight="bold")
        self.label_font = tkfont.Font(family="Segoe UI",
                                      size=12)
        
        # Title Frame
        title_frame = tk.Frame(self, bg="#222831")
        title_frame.pack(pady=(18, 10))
        
        title_label = tk.Label(
            title_frame,
            text="Mood Palette",
            font=self.title_font,
            fg="#00ADB5",
            bg="#222831"
        )
        
        subtitle_label = tk.Label(
            title_frame,
            text="Visualize your mood as colors.",
            font=self.label_font,
            fg="#EEEEEE",
            bg="#222831"
        )
        
        title_label.pack()
        subtitle_label.pack()

        # Mood Selection Frame
        selection_frame = tk.Frame(self, bg="#393E46")
        selection_frame.pack(pady=(10,16))
        
        mood_var = tk.StringVar(value='Calm')
        
        label = tk.Label(selection_frame, text='Select your current mood:',
                        font=self.label_font, bg='#393E46', fg='#EEEEEE')
        label.grid(row=0, column=0, padx=(12), pady=(8), sticky='w')

        moods = list(MOOD_PALETTES.keys())
        
        option_menu = tk.OptionMenu(selection_frame, mood_var, *moods, 
                                   command=self.update_palette)
        option_menu.config(font=('Segoe UI', 11), bg='#00ADB5', fg='#fff',
                          activebackground='#118AB2', activeforeground='#fff',
                          highlightthickness=0, cursor='hand2')
        
        option_menu.grid(row=1, column=0, padx=(12), pady=(4))
        
        # Color display frame
        palette_display = tk.Frame(self, bg='#232931')
        palette_display.pack(fill='both', expand=True, padx=(24), pady=(14))
        self.palette_display = palette_display
        
        # Store var for later update:
        self.mood_var = mood_var
        
        # Initial display:
        self.update_palette('Calm')

    def update_palette(self, mood_name=None):
        if not isinstance(mood_name, str):  # Called by OptionMenu event; get value.
            mood_name = self.mood_var.get()
            
        # Clear current palette
        for widget in self.palette_display.winfo_children():
            widget.destroy()
            
        # Get colors for the selected mood
        colors = MOOD_PALETTES[mood_name]
        
        # Create and display color swatches
        for i, color in enumerate(colors):
            swatch = ColorSwatch(self.palette_display, color, self.copy_to_clipboard)
            swatch.grid(row=0, column=i, padx=5, pady=5)
            
    def copy_to_clipboard(self, hex_code):
        self.clipboard_clear()
        self.clipboard_append(hex_code)
        messagebox.showinfo("Copied!", f"{hex_code} has been copied to clipboard.")

class ColorSwatch(tk.Frame):
    def __init__(self, master, color_hex, on_copy, *args, **kwargs):
       super().__init__(master, *args, bg=color_hex, width=60, height=60, borderwidth=1,
                        relief='ridge', **kwargs)
       self.color_hex = color_hex 
       swatch = tk.Label(self, text="", bg=color_hex, width=8, height=3)
       swatch.pack()
       
       btn = tk.Button(self, text=color_hex, font=("Consolas","10"),
                     command=lambda: on_copy(color_hex), bg='#eeeeee', fg='#232931',
                     relief='flat', cursor='hand2')
       btn.pack(pady=(4,0))

def main():
   app = MoodPaletteApp()
   app.mainloop()

if __name__ == "__main__":
   main()
```

