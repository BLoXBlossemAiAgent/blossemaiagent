        self.secondary_color = "#4A6491"  # Medium blue
        self.accent_color = "#F9A826"  # Orange
        self.text_color = "#FFFFFF"  # White
        self.light_bg = "#EEF2F7"  # Light background
        
        self.create_widgets()
        
    def create_widgets(self):
        # Header frame
        header_frame = tk.Frame(self.root, bg=self.primary_color, pady=10)
        header_frame.pack(fill="x")
        
        title_label = tk.Label(
            header_frame, 
            text="Weather Dashboard", 
            font=self.title_font, 
            bg=self.primary_color, 
            fg=self.text_color
        )
        title_label.pack()
        
        # Search frame
        search_frame = tk.Frame(self.root, bg=self.secondary_color, pady=15, padx=20)
        search_frame.pack(fill="x")
        
        search_label = tk.Label(
            search_frame, 
            text="Enter City:", 
            font=self.normal_font, 
            bg=self.secondary_color, 
            fg=self.text_color
        )
        search_label.pack(side="left", padx=(0, 10))
        
        self.city_entry = tk.Entry(
            search_frame, 
            font=self.normal_font, 
            width=20, 
            bd=2, 
            relief="groove"
        )
        self.city_entry.pack(side="left", padx=(0, 10))
        self.city_entry.focus()
        
        search_button = tk.Button(
            search_frame, 
            text="Search", 
            font=self.normal_font, 
            bg=self.accent_color, 
            fg=self.primary_color,
            activebackground="#E09415",
            activeforeground=self.text_color,
            bd=0,
            padx=10,
            pady=2,
            cursor="hand2",
            command=self.get_weather
        )
        search_button.pack(side="left")
        
        # Bind Enter key to search function
        self.city_entry.bind("<Return>", lambda event: self.get_weather())
        
        # Results frame
        self.results_frame = tk.Frame(self.root, bg=self.light_bg, padx=20, pady=20)
        self.results_frame.pack(fill="both", expand=True, padx=20, pady=20)
        
        # Initial message
        self.initial_message = tk.Label(
            self.results_frame, 
            text="Enter a city name to check the current weather", 
            font=self.header_font, 
            bg=self.light_bg,
            fg=self.primary_color
        )
        self.initial_message.pack(pady=50)
        
